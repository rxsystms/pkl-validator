{
  "name": "pkl-validator",
  "displayName": "PKL Validator",
  "description": "Validate PKL files in VS Code and show diagnostics in the Problems panel.",
  "publisher": "rxsystms",
  "version": "0.1.2",
  "icon": "resources/logo.png",
  "repository": "https://github.com/rxsystms/pkl-validator",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:pkl-validator.validateCurrentFile"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pkl-validator.validateCurrentFile",
        "title": "Validate current file with PKL"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.5.4"
  }
}
